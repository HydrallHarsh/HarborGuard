# Copy this file to .env and fill in local values.
# Do not commit .env.

# =============================================================================
# Optional server defaults (users can override in the HarborGuard UI)
# =============================================================================
# Coral / source tokens — also configurable per user in the landing page.
# GitHub: gh auth token or PAT
GITHUB_TOKEN=
NOTION_API_KEY=
SLACK_TOKEN=

# OpenRouter AI planner — also configurable per user in the landing page.
# Toggle + key + model can be set in UI; these are server fallbacks.
HARBORGUARD_USE_LLM_PLANNER=false
OPENROUTER_API_KEY=
# OpenRouter model slug, e.g. openai/gpt-oss-120b:free or qwen/qwen3-235b-a22b:free
OPENROUTER_MODEL=

# =============================================================================
# Deploy / host only (do not expose in UI)
# =============================================================================
# Keep HarborGuard on the same Coral config you use when adding sources.
CORAL_CONFIG_DIR=%APPDATA%\withcoral\harborguard-config

# Local Coral binary in harborguard/coral-download/ (extract coral-x86_64-*.zip there).
# Leave unset to auto-detect coral-download/coral.exe; set to override.
CORAL_BIN=coral-download/coral.exe

HARBORGUARD_LOG_LEVEL=INFO
HARBORGUARD_CORS_ORIGINS=http://localhost:3000

CORAL_QUERY_TIMEOUT_SECONDS=20
CORAL_METADATA_TIMEOUT_SECONDS=6
OPENROUTER_TIMEOUT_SECONDS=15

# Discovery backend: "sql" or "mcp"
HARBORGUARD_DISCOVERY_BACKEND=sql
CORAL_MCP_TIMEOUT_SECONDS=8

# Demo fallback fixtures — canned JSON, no live Coral queries.
HARBORGUARD_USE_FIXTURES=false
